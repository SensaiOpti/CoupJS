# Use this as a basis for your own .env file. Just input the values you need.

# --- Security (already existed, just wasn't documented) ---
# Signs login tokens. If left unset, the server falls back to an insecure
# hardcoded default - fine for local testing, but MUST be set to a long
# random string before this is ever reachable from outside your own machine.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Email (for password reset) ---
# Without these, password reset still works end-to-end, but the reset link
# is printed to the server console instead of actually being emailed.
# Below example is a partial Gmail.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Coup <your-account@gmail.com>

# The public URL of your site, used to build the link inside reset emails.
# Must NOT have a trailing slash.
APP_BASE_URL=http://localhost:3001

# Port the server listens on. Defaults to 3001 if unset.
PORT=3001
