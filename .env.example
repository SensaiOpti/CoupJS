# Use this as a basis for your own .env file. Just input the values you need.

# --- Security (already existed, just wasn't documented) ---
# Signs login tokens. If left unset, the server falls back to an insecure
# hardcoded default - fine for local testing, but MUST be set to a long
# random string before this is ever reachable from outside your own machine.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Reverse proxy / CDN ---
# Controls how much to trust proxy-supplied headers (X-Forwarded-For, etc.)
# when determining a visitor's real IP - used for rate limiting (login
# attempts, room passwords, ...) and IP bans, so getting this right matters
# once something sits in front of Node. Leave unset if Node is directly
# exposed to the internet with nothing in front of it.
#
# Otherwise, set to:
#   cloudflare  - behind Cloudflare, whether a standard Cloudflare-proxied
#                 domain or a Cloudflare Tunnel (cloudflared)
#   a number    - behind a plain reverse proxy/CDN instead. 1 = a single
#                 reverse proxy (nginx, your host's load balancer) directly
#                 in front of Node; 2 = e.g. a CDN in front of that proxy
# Whichever you pick, make sure Node's port isn't ALSO reachable directly
# (bypassing the proxy/tunnel) - see README.md "Configuration" for more deets.
TRUST_PROXY=

# --- Security headers ---
# The server sends a Content-Security-Policy restricting which origins
# scripts/styles/connections can come from. Defaults to report-only mode -
# violations are logged in the browser's console but nothing is actually
# blocked - so it can never break your deployment on its own. Once you've
# opened your own instance and checked the browser console for unexpected
# violations (relevant mainly if you've added custom decks/sounds/assets),
# set this to 'true' to enforce it for real. See README.md for details.
CSP_ENFORCE=

# --- Email (for password reset) ---
# Without these, password reset still works end-to-end, but the reset link
# is printed to the server console instead of actually being emailed.
# Below example is a partial Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Coup <your-account@gmail.com>

# The public URL of your site, used to build the link inside reset emails.
# Must NOT have a trailing slash.
APP_BASE_URL=http://localhost:3001

# Port the server listens on. Defaults to 3001 if unset.
PORT=3001

# --- Abuse limits (all optional - the defaults are meant to be left alone) ---
# Every per-IP number below is deliberately a HIGH ceiling that
# only a flood should ever reach. Limits on a single account, username or
# connection are stricter and are not configurable. Raise a number if a large group
# really does play from one address, lower it to be stricter.

# Open connections at once / new connections per minute, per IP address
#MAX_CONNECTIONS_PER_IP=200
#CONNECTIONS_PER_MINUTE_PER_IP=600
# Every page/API request, per IP, per 15 minutes
#API_REQUESTS_PER_15MIN_PER_IP=3000
# New accounts per IP per hour
#REGISTRATIONS_PER_HOUR_PER_IP=30
# WRONG-password logins per IP per 15 minutes (any usernames), and per username from one IP
#FAILED_LOGINS_PER_15MIN_PER_IP=100
#FAILED_LOGINS_PER_ACCOUNT_AND_IP=10
# Chat messages per 10 seconds per IP (each connection/account also has its own, lower limit)
#CHAT_MESSAGES_PER_10S_PER_IP=200
# Game rooms created per minute per IP; rooms open on the whole server; spectators in one room
#ROOMS_CREATED_PER_MIN_PER_IP=60
#MAX_ROOMS=2000
#MAX_SPECTATORS_PER_ROOM=100

# --- Which websites may connect to the game server ---
# Pages served by this server always work, as does APP_BASE_URL above. Only needed
# if your pages are served from a DIFFERENT address than the server (comma-separated,
# e.g. https://play.example.com,https://example.com:8443). If a legitimate address is
# being refused, the server log says so - add it here.
#ALLOWED_ORIGINS=

# Set to true to switch the check off entirely
#ALLOW_ANY_ORIGIN=false
